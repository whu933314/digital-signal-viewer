{
 "source": "MATLAB R2025a spectrumAnalyzer captures, 2026-10-24 (scope_capture/scope_capture.m -> out/<name>.json); extracted by work2/distortion/extract_scope_ref.py. Only configuration, the scope's DistortionMeasurements numbers, the signal reference and grid metadata are kept; displayed spectra are NOT copied (reproduced from the signal).",
 "matlab_version": "R2025a (25.1.0.2943329)",
 "json_note": "-Infinity / Infinity / NaN appear as bare literals (like MATLAB jsonencode ConvertInfAndNaN=false); Python json.load reads them.",
 "common_scope_config": "release(sa); Method welch, Window hann, OverlapPercent 0, FrequencyResolutionMethod window-length, WindowLength = N (one call = one periodogram), FFTLengthSource auto (NFFT = max(1024, N)), AveragingMethod running, SpectralAverages 1, ReferenceLoad 1, FrequencySpan full (unless scope_props), PlotNormalTrace true, PlotMaxHoldTrace false (unless scope_props), MeasurementChannel 1.",
 "spectrum_model": {
  "window": "hann periodic 0.5-0.5cos(2*pi*n/L), n=0..L-1",
  "nfft": "max(1024, L)",
  "power": "|X|^2/(sum w)^2 (W per bin, dBm = 10log10+30)",
  "psd": "|X|^2/(fs*sum w^2) (W/Hz)",
  "one_sided": "k=0..NFFT/2 (odd NFFT: 0..(NFFT-1)/2), interior bins x2, DC and Nyquist not doubled",
  "two_sided": "MATLAB centered: k=-NFFT/2+1..NFFT/2, Nyquist at +fs/2",
  "rbw": "ENBW = fs*sum(w^2)/sum(w)^2 = 1.5*fs/L",
  "validated": "fresh displays match to <= 4.8e-10 dB (fs 48e3) / 9.5e-13 dB (fs 1e4); ANALYSIS.md section 1"
 },
 "rules": {
  "rules": [
   {
    "id": "D1",
    "rule": "input = displayed trace in linear power (W/bin), positive frequencies only: one-sided trace as is; two-sided: bins f >= 0 as displayed (not doubled, +fs/2 included) -> absolute powers 3.0103 dB lower, ratios nearly unchanged; power-density trace converted by x RBW for the algorithm",
    "proof": "dist_h_offbin_2s_N6 (23.977307037 vs 26.987606994 dBm; SNR 76.0847206906 vs 76.0854767017), dist_toi_doc_2s (TOI 28.2224990617 = 31.2327990184 - 3.0103), dist_cplx_obw_2s_harmonic_N6"
   },
   {
    "id": "D2",
    "rule": "DC: from bin 0 walk right while P[i+1] <= P[i]; clear bins 0..R0; W0 = (R0+1)*df",
    "proof": "all harmonic captures (W0 part of the SNR match)"
   },
   {
    "id": "D3",
    "rule": "fundamental: t1 = argmax; skirt = walk left while P[L-1] <= P[L], right while P[R+1] <= P[R]; Fe1 = power centroid over [L,R] (aiming only); P1 = P[t1] PEAK-BIN value (not integrated); W1 = (R-L+1)*df; clear [L,R]; reported Frequency = f[t1]",
    "proof": "dist_h_noisy_1s_N6: 25.832889395 dBm = 0.5 W x Hann loss at 0.45 bin offset (integrated band would be 27.0); dist_h_noiseless_1s_N6: 26.98970004336018 = exactly 0.5 W; 14 captures Power <= 1.3e-11 dB"
   },
   {
    "id": "D4",
    "rule": "harmonic k: tb = round(k*Fe1/df); if tb > last bin -> stop, row omitted (no aliasing, no width added); else t = argmax over [tb-1, tb+1] of the cleared working trace; skirt walk from t EVEN IF P[t]==0 (runs through the cleared region, which is counted again in W_k); P_k = P[t] (0 -> Power -Inf); W_k = (R-L+1)*df; clear [L,R]; Frequency = f[t]",
    "proof": "dist_h_lowf_1s_N6 (rows 2,5,6 -Inf; Wsum must be 82 bins = 1+7+7+10+19+19+19; all fields <= 3.6e-14), dist_h_odd_1s_N6 (noise harmonics 5,6 found at bins 256, 307), dist_h_alias_1s_N6 (rows 1-2 only), dist_h_offbin_1s_N10 (9 rows)"
   },
   {
    "id": "D5",
    "rule": "Pnoise = (sum(remaining bins)*df + median(remaining non-zero bins)*Wsum)/RBW, Wsum = W0+W1+...+Wn (documented formula taken literally)",
    "proof": "SNR matched to <= 1.9e-12 dB in 14 captures (dist_h_offbin_1s_N6 Pnoise -49.097869708 dBm)"
   },
   {
    "id": "D6",
    "rule": "THD = 10log10(sum P_k/P1); THD% = 100*10^(THD/20); SNR = 10log10(P1/Pnoise); SINAD = 10log10(P1/(sum P_k + Pnoise)); SFDR = 10log10(P1/max(P_maxspur, max P_k)) - P_k term verified, P_maxspur term NOT (see unresolved)",
    "proof": "14 harmonic captures <= 1.3e-11 dB; SFDR = P1 - max P_k in all of them"
   },
   {
    "id": "D7",
    "rule": "intermodulation: DC as D2; tone a = strongest peak, tone b = next (skirt, centroid, peak-bin power, cleared); products at 2Fe_a-Fe_b (row 3) and 2Fe_b-Fe_a (row 4) with the +-1 bin window and peak-bin power; rows [a, b, 2a-b, 2b-a]; TOI = mean(P_a+(P_b-P_2a-b)/2, P_b+(P_a-P_2b-a)/2) in dBm; product < 0 Hz -> Power -Inf, TOI +Inf",
    "proof": "dist_toi_doc_1s/2s, dist_toi_bin_1s, dist_toi_unequal_1s (<= 1.2e-13 dB), dist_toi_lowimd_dc_1s (-Inf / Inf)"
   },
   {
    "id": "D8",
    "rule": "measurement range = full Nyquist range of the trace, independent of scope FrequencySpan; NumHarmonics limited only by Nyquist",
    "proof": "dist_h_offbin_1s_span_0_6000_N6 and _span_1000_24000_N6 identical to dist_h_offbin_1s_N6"
   },
   {
    "id": "D9",
    "rule": "normal trace used when Max-Hold is on",
    "proof": "dist_h_maxhold_2calls: 70.3125 Hz / 5.882335644 dBm (0.1*h_lowf)"
   },
   {
    "id": "D10",
    "rule": "complex input: computed (no blank/error) on the positive half",
    "proof": "dist_cplx_obw_2s_harmonic_N6 reproduced to 4.3e-14 dB"
   },
   {
    "id": "D11",
    "rule": "power-density mode: Power rows in dBm/Hz (dBm value - 10log10(RBW)); THD/SNR/SINAD/SFDR unchanged",
    "proof": "dist_h_offbin_1s_psd_N6 (11.527582 vs 26.987607)"
   }
  ],
  "rejected": [
   {
    "rule": "thd/snr/sinad/sfdr(...,'power') semantics (integrated tone bands, no sequential clearing)",
    "residual": "P1 2.1e-3 dB (h_offbin) .. 1.17 dB (h_noisy); THD 8.8e-3 dB"
   },
   {
    "rule": "harmonic power = integrated skirt band * df/RBW",
    "residual": "same as above"
   },
   {
    "rule": "W_k = 0 for harmonics landing in cleared regions",
    "residual": "SNR 0.13 dB on dist_h_lowf_1s_N6"
   }
  ]
 },
 "unresolved": [
  {
   "item": "SFDR non-harmonic spur term (P_maxspur)",
   "evidence": "dist_h_alias_1s_N6 SFDR 28.745379327537 implies a spur of -1.911564462 dBm; max remaining bin gives 35.47; clearing only peak+-1 bins gives 28.534 (0.21 dB off); no bin/sum/scaled candidate matches",
   "needed": "capture with a known spur above all harmonics"
  },
  {
   "item": "Frequency reported for a non-existent IM3 product",
   "evidence": "dist_toi_lowimd_dc_1s row 4: 4171.875 Hz (one bin below the found upper product); Power -Inf and TOI Inf are clear"
  },
  {
   "item": "round-off-level fields of dist_h_noiseless_1s_N6 (rows 4-6, SNR 276.91)",
   "evidence": "FFT round-off (1e-28 W), implementation dependent"
  },
  {
   "item": ">70 % leakage blanking of SNR/SINAD; FrequencyOffset != 0",
   "evidence": "not exercised"
  }
 ],
